<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>f96370d1-d26f-4650-9ac4-a3e366ac96c6</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.12">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <!-- Let Swashbuckle bring the correct Microsoft.OpenApi dependency to avoid version mismatch -->
    <PackageReference Include="Swashbuckle.AspNetCore" Version="10.2.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\EnterpriseAI.Application\EnterpriseAI.Application.csproj" />
    <ProjectReference Include="..\EnterpriseAI.Infrastructure\EnterpriseAI.Infrastructure.csproj" />
  </ItemGroup>

</Project>
